import numpy as np
import matplotlib.pyplot as plt

# Numerical example values 

r_m = 0.02      
K_m = 0.1       
L_m = 0.005     
R_m = 2.0       
J_eq = 1.5e-4   

# Time and frequency
t = np.linspace(0, 10, 1000)
omega = 2 * np.pi / 5  
theta = omega * t

# Scale factor for the heart
S = 0.003 
A = 16 * S
B = S

x_pos = A * np.sin(theta)**3
x_vel = A * omega * (3 * np.sin(theta)**2 * np.cos(theta))
x_acc = A * omega**2 * (3 * (2 * np.sin(theta) * np.cos(theta)**2 - np.sin(theta)**3))
x_jerk = A * omega**3 * (3 * (2 * np.cos(theta)**3 - 7 * np.sin(theta)**2 * np.cos(theta)))
    
y_pos = B * (13 * np.cos(theta) - 5 * np.cos(2 * theta) - 2 * np.cos(3 * theta) - np.cos(4 * theta))
y_vel = B * omega * (-13 * np.sin(theta) + 10 * np.sin(2 * theta) + 6 * np.sin(3 * theta) + 4 * np.sin(4 * theta))
y_acc = B * omega**2 * (-13 * np.cos(theta) + 20 * np.cos(2 * theta) + 18 * np.cos(3 * theta) + 16 * np.cos(4 * theta))
y_jerk = B * omega**3 * (13 * np.sin(theta) - 40 * np.sin(2 * theta) - 54 * np.sin(3 * theta) - 64 * np.sin(4 * theta))

# Inverse Dynamics
coeff_current = (2 * J_eq) / (K_m * r_m)

i_x = coeff_current * x_acc
di_x_dt = coeff_current * x_jerk

i_y = coeff_current * y_acc
di_y_dt = coeff_current * y_jerk

u_x = L_m * di_x_dt + (2 * K_m / r_m) * x_vel + R_m * i_x
u_y = L_m * di_y_dt + (2 * K_m / r_m) * y_vel + R_m * i_y

u_ml = 0.5 * (u_x + u_y)
u_mr = 0.5 * (u_x - u_y)

# Plots
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))

ax1.plot(x_pos, y_pos, 'r-', linewidth=2)
ax1.set_title('Desired Tool Head Trajectory (Heart)')
ax1.set_xlabel('x [m]')
ax1.set_ylabel('y [m]')
ax1.grid(True)
ax1.axis('equal')

ax2.plot(t, u_ml, label='Left Motor Voltage ($u_{m,l}$)')
ax2.plot(t, u_mr, label='Right Motor Voltage ($u_{m,r}$)')
ax2.set_title('Required Motor Input Voltages')
ax2.set_xlabel('Time [s]')
ax2.set_ylabel('Voltage [V]')
ax2.legend()
ax2.grid(True)

plt.tight_layout()
plt.show()